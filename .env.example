# ==============================================================================
# AMP AI Centralized Production Multi-Tenant & Encryption Environment Configuration
# ==============================================================================

# Server Configuration (FastAPI on port 8000)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Shared Database Configuration
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ytteriq_amp_ai
MONGODB_COLLECTION=reels

# ------------------------------------------------------------------------------
# 2. AWS KMS Envelope Encryption Configuration
# ------------------------------------------------------------------------------
# AWS Region where Customer Master Key (CMK) resides
AWS_REGION=us-east-1
# AWS KMS Key ARN or Key ID (Used to wrap and unwrap per-agency DEKs)
# Prefer attaching an IAM Role (e.g. EC2/ECS/EKS/Lambda execution role) rather than permanent keys
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/amp-root-master-key
# Optional custom endpoint (for LocalStack / VPC private endpoints)
AWS_KMS_ENDPOINT_URL=
# Fallback credentials only if hosting platform does NOT support IAM roles:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Fallback to local cryptographic master key mock for offline unit testing & local development
KMS_MOCK_FALLBACK=true
# Time-to-live for short-lived, in-memory DEK cache (seconds)
DEK_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 3. Authentication & Tenant Session Configuration
# ------------------------------------------------------------------------------
# Shared HMAC session secret (at least 32 characters, aligned with AMP control plane)
SESSION_SECRET=your-production-session-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=marketingos_session
PLATFORM_COOKIE_NAME=ytteriq_platform_session
# Enforce strict JWT/cookie authentication across all endpoints (set true in production)
AUTH_ENFORCE=true

# ------------------------------------------------------------------------------
# 4. LLM API Providers
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_analysis_groq_api_key
LLM_MODEL=openai/gpt-oss-120b

STORYTELLING_MODEL=openai/gpt-oss-20b
STORYTELLING_API_KEY=your_storytelling_api_key
