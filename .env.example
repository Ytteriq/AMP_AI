# ==============================================================================
# AI_REEL Centralized Environment Configuration
# ==============================================================================

# Server Configuration (Single centralized FastAPI backend on port 8000)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ------------------------------------------------------------------------------
# 1. Analysis Agent Groq LLM Configuration (DO NOT CHANGE)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_analysis_groq_api_key
LLM_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 2. Storytelling Agent Groq LLM Configuration (Independent Client)
# ------------------------------------------------------------------------------
STORYTELLING_MODEL=openai/gpt-oss-20b
STORYTELLING_API_KEY=your_storytelling_api_key

# ------------------------------------------------------------------------------
# 3. MongoDB Atlas Database Configuration
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ahqejpt.mongodb.net/ytteriq_amp_ai
MONGODB_DATABASE=ytteriq_amp_ai
MONGODB_COLLECTION=reels
